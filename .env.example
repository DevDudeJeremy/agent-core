# agent-core — server-side environment, for a REAL deployment only.
#
# You need none of this to run the tests, the build or the offline demo: `npm test` and
# `npm run demo` work with no .env file and no keys.
#
# These are secrets or server config. None of them is browser-safe — never expose them
# client-side. Copy this file to .env on the deployment host and fill it in; never commit
# a filled-in .env. The package imports fine with none of these set: env is read only
# inside fromEnv(), at call time.

# Anthropic Messages API key — powers the conversation model.
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-haiku-4-5 when unset.
AGENT_MODEL=

# Voyage AI key — embeddings for RAG (Anthropic has no embeddings API).
VOYAGE_API_KEY=

# Supabase project URL (e.g. https://xxxx.supabase.co).
SUPABASE_URL=

# Supabase SERVICE-ROLE key. Server-side only, full access — NEVER exposed client-side.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of browser Origins allowed to call the agent (CORS allowlist).
# e.g. https://example.com,https://www.example.com
AGENT_ALLOWED_ORIGINS=
